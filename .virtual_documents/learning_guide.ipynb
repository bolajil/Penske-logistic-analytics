# Template 3: Apply ML Models to Real Data
# Reuse the trained models from earlier sections

def analyze_real_fleet_data(real_df: pd.DataFrame) -> dict:
    """
    Apply fleet performance analysis to real data.
    Uses the same techniques from Section 4 & 5.
    """
    results = {}
    
    # Calculate KPIs (same as Section 4)
    if 'on_time_rate' in real_df.columns:
        results['on_time_rate'] = real_df['on_time_rate'].mean() * 100
    if 'load_capacity_used' in real_df.columns:
        results['fleet_utilization'] = real_df['load_capacity_used'].mean()
    if 'miles_driven' in real_df.columns and 'fuel_consumed' in real_df.columns:
        results['fuel_efficiency'] = real_df['miles_driven'].sum() / real_df['fuel_consumed'].sum()
    
    # Regional breakdown
    if 'region' in real_df.columns:
        results['regional_performance'] = real_df.groupby('region').agg({
            col: 'mean' for col in ['on_time_rate', 'load_capacity_used'] 
            if col in real_df.columns
        }).to_dict()
    
    return results

def score_real_leads(real_leads_df: pd.DataFrame, lead_scorer) -> pd.DataFrame:
    """
    Score real leads using the trained model from Section 6.
    """
    # Ensure lead_scorer is trained
    if not hasattr(lead_scorer, 'model') or lead_scorer.model is None:
        print("Warning: Lead scorer not trained. Train first with synthetic data.")
        return real_leads_df
    
    return lead_scorer.score_leads(real_leads_df)

def predict_real_churn(real_customer_df: pd.DataFrame, churn_predictor) -> pd.DataFrame:
    """
    Predict churn risk for real customers using the trained model from Section 6.
    """
    if not hasattr(churn_predictor, 'model') or churn_predictor.model is None:
        print("Warning: Churn predictor not trained. Train first with synthetic data.")
        return real_customer_df
    
    return churn_predictor.predict_churn_risk(real_customer_df)

