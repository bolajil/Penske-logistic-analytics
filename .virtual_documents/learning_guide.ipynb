def map_columns(df: pd.DataFrame, mapping: dict) -> pd.DataFrame:
    """Apply column mapping to standardize your data."""
    df_mapped = df.copy()
    reverse_mapping = {v: k for k, v in mapping.items() if k in df.columns}
    actual_mapping = {k: v for k, v in mapping.items() if k in df.columns}
    
    if actual_mapping:
        df_mapped = df_mapped.rename(columns=actual_mapping)
        print(f"Mapped columns: {actual_mapping}")
    else:
        print("No columns matched the mapping. Check your column names.")
    
    return df_mapped

